{
  "name": "remotefs-2",
  "displayName": "Remote FS 2",
  "description": "%description%",
  "version": "0.3.2",
  "publisher": "michediana",
  "author": "Michele Diana",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Michediana/vscode-remote-fs-2.git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "ftp",
    "ftps",
    "sftp",
    "filesystem",
    "remote"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onFileSystem:sftp",
    "onFileSystem:ftp",
    "onFileSystem:ftps",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%",
      "restrictedConfigurations": [
        "remotefs.remote"
      ]
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remotefs",
          "title": "Remote FS 2",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "remotefs": [
        {
          "id": "remotefs.connections",
          "name": "%view.connections%",
          "icon": "$(server-environment)",
          "contextualTitle": "Remote FS 2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remotefs.connections",
        "contents": "%view.connections.welcome%"
      }
    ],
    "commands": [
      {
        "command": "remotefs.addFolderToWorkspace",
        "title": "%command.addFolderToWorkspace%",
        "category": "Remote FS 2",
        "icon": "$(add)"
      },
      {
        "command": "remotefs.openMirror",
        "title": "%command.openMirror%",
        "category": "Remote FS 2",
        "icon": "$(cloud-download)"
      },
      {
        "command": "remotefs.downloadMirrorFolder",
        "title": "%command.downloadMirrorFolder%",
        "category": "Remote FS 2",
        "icon": "$(cloud-download)"
      },
      {
        "command": "remotefs.syncMirror",
        "title": "%command.syncMirror%",
        "category": "Remote FS 2",
        "icon": "$(sync)"
      },
      {
        "command": "remotefs.resolveMirrorConflicts",
        "title": "%command.resolveMirrorConflicts%",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.unlinkMirror",
        "title": "%command.unlinkMirror%",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.openSettings",
        "title": "%command.openSettings%",
        "category": "Remote FS 2",
        "icon": "$(gear)"
      },
      {
        "command": "remotefs.showActivity",
        "title": "%command.showActivity%",
        "category": "Remote FS 2",
        "icon": "$(pulse)"
      },
      {
        "command": "remotefs.addConnection",
        "title": "%command.addConnection%",
        "category": "Remote FS 2",
        "icon": "$(add)"
      },
      {
        "command": "remotefs.editConnection",
        "title": "%command.editConnection%",
        "category": "Remote FS 2",
        "icon": "$(edit)"
      },
      {
        "command": "remotefs.duplicateConnection",
        "title": "%command.duplicateConnection%",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.deleteConnection",
        "title": "%command.deleteConnection%",
        "category": "Remote FS 2",
        "icon": "$(trash)"
      },
      {
        "command": "remotefs.openInWorkspace",
        "title": "%command.openInWorkspace%",
        "category": "Remote FS 2",
        "icon": "$(folder-opened)"
      },
      {
        "command": "remotefs.openInNewWindow",
        "title": "%command.openInNewWindow%",
        "category": "Remote FS 2",
        "icon": "$(empty-window)"
      },
      {
        "command": "remotefs.openInCurrentWindow",
        "title": "%command.openInCurrentWindow%",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.testConnection",
        "title": "%command.testConnection%",
        "category": "Remote FS 2",
        "icon": "$(debug-alt-small)"
      },
      {
        "command": "remotefs.disconnect",
        "title": "%command.disconnect%",
        "category": "Remote FS 2",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "remotefs.disconnectAll",
        "title": "%command.disconnectAll%",
        "category": "Remote FS 2",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "remotefs.forgetPassword",
        "title": "%command.forgetPassword%",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.searchConnections",
        "title": "%command.searchConnections%",
        "category": "Remote FS 2",
        "icon": "$(search)"
      },
      {
        "command": "remotefs.refresh",
        "title": "%command.refresh%",
        "category": "Remote FS 2",
        "icon": "$(refresh)"
      },
      {
        "command": "remotefs.exportConnections",
        "title": "%command.exportConnections%",
        "category": "Remote FS 2",
        "icon": "$(export)"
      },
      {
        "command": "remotefs.importConnections",
        "title": "%command.importConnections%",
        "category": "Remote FS 2",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "remotefs.openSettingsJson",
        "title": "%command.openSettingsJson%",
        "category": "Remote FS 2",
        "icon": "$(json)"
      },
      {
        "command": "remotefs.showLog",
        "title": "%command.showLog%",
        "category": "Remote FS 2",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remotefs.searchConnections",
          "when": "view == remotefs.connections",
          "group": "navigation@-1"
        },
        {
          "command": "remotefs.openSettings",
          "when": "view == remotefs.connections",
          "group": "navigation@0"
        },
        {
          "command": "remotefs.addConnection",
          "when": "view == remotefs.connections",
          "group": "navigation@1"
        },
        {
          "command": "remotefs.refresh",
          "when": "view == remotefs.connections",
          "group": "navigation@2"
        },
        {
          "command": "remotefs.disconnectAll",
          "when": "view == remotefs.connections",
          "group": "navigation@3"
        },
        {
          "command": "remotefs.importConnections",
          "when": "view == remotefs.connections",
          "group": "more@1"
        },
        {
          "command": "remotefs.exportConnections",
          "when": "view == remotefs.connections",
          "group": "more@2"
        },
        {
          "command": "remotefs.openSettingsJson",
          "when": "view == remotefs.connections",
          "group": "more@3"
        },
        {
          "command": "remotefs.showLog",
          "when": "view == remotefs.connections",
          "group": "more@4"
        }
      ],
      "view/item/context": [
        {
          "command": "remotefs.openInWorkspace",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "inline@1"
        },
        {
          "command": "remotefs.openMirror",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "inline@2"
        },
        {
          "command": "remotefs.editConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "inline@3"
        },
        {
          "command": "remotefs.disconnect",
          "when": "view == remotefs.connections && viewItem == remotefs.connection.connected",
          "group": "inline@4"
        },
        {
          "command": "remotefs.openInWorkspace",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@1"
        },
        {
          "command": "remotefs.openInNewWindow",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@2"
        },
        {
          "command": "remotefs.openMirror",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@4"
        },
        {
          "command": "remotefs.openInCurrentWindow",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@3"
        },
        {
          "command": "remotefs.testConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "2_conn@1"
        },
        {
          "command": "remotefs.disconnect",
          "when": "view == remotefs.connections && viewItem == remotefs.connection.connected",
          "group": "2_conn@2"
        },
        {
          "command": "remotefs.forgetPassword",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "2_conn@3"
        },
        {
          "command": "remotefs.editConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@1"
        },
        {
          "command": "remotefs.duplicateConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@2"
        },
        {
          "command": "remotefs.exportConnections",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@3"
        },
        {
          "command": "remotefs.deleteConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@4"
        }
      ],
      "commandPalette": [
        {
          "command": "remotefs.openInWorkspace",
          "when": "false"
        },
        {
          "command": "remotefs.openInCurrentWindow",
          "when": "false"
        },
        {
          "command": "remotefs.duplicateConnection",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "remotefs.openMirror",
          "when": "explorerResourceIsFolder && resourceScheme =~ /^(s?ftp|ftps)$/",
          "group": "remotefs@1"
        },
        {
          "command": "remotefs.downloadMirrorFolder",
          "when": "explorerResourceIsFolder && resourceScheme == file && remotefs.hasMirror",
          "group": "remotefs@2"
        },
        {
          "command": "remotefs.syncMirror",
          "when": "explorerResourceIsRoot && resourceScheme == file && remotefs.hasMirror",
          "group": "remotefs@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Remote FS 2",
      "properties": {
        "remotefs.rootLabel": {
          "type": "string",
          "markdownDescription": "%config.rootLabel%",
          "default": "${label}"
        },
        "remotefs.remote": {
          "type": "object",
          "markdownDescription": "%config.remote%",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "required": [
              "scheme",
              "host"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "enum": [
                  "sftp",
                  "ftp",
                  "ftps"
                ],
                "description": "%config.remote.scheme%"
              },
              "label": {
                "type": "string",
                "description": "%config.remote.label%"
              },
              "host": {
                "type": "string",
                "description": "%config.remote.host%"
              },
              "port": {
                "type": "number",
                "description": "%config.remote.port%"
              },
              "username": {
                "type": "string",
                "description": "%config.remote.username%"
              },
              "password": {
                "type": "string",
                "description": "%config.remote.password%"
              },
              "rootPath": {
                "type": "string",
                "description": "%config.remote.rootPath%",
                "default": "/"
              },
              "connectTimeout": {
                "type": "number",
                "description": "%config.remote.connectTimeout%",
                "default": 10000
              },
              "privateKeyPath": {
                "type": "string",
                "description": "%config.remote.privateKeyPath%"
              },
              "passphrase": {
                "type": [
                  "string",
                  "boolean"
                ],
                "description": "%config.remote.passphrase%"
              },
              "agent": {
                "type": "string",
                "description": "%config.remote.agent%"
              },
              "interactiveAuth": {
                "type": "boolean",
                "description": "%config.remote.interactiveAuth%",
                "default": false
              },
              "algorithms": {
                "type": "object",
                "description": "%config.remote.algorithms%"
              },
              "secure": {
                "type": [
                  "boolean",
                  "string"
                ],
                "enum": [
                  true,
                  false,
                  "implicit"
                ],
                "description": "%config.remote.secure%"
              },
              "rejectUnauthorized": {
                "type": "boolean",
                "description": "%config.remote.rejectUnauthorized%",
                "default": true
              }
            }
          }
        },
        "remotefs.mirror.baseFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.mirror.baseFolder%"
        },
        "remotefs.mirror.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            "node_modules",
            ".DS_Store",
            "Thumbs.db"
          ],
          "markdownDescription": "%config.mirror.exclude%"
        },
        "remotefs.mirror.maxFileSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "markdownDescription": "%config.mirror.maxFileSizeMB%"
        },
        "remotefs.mirror.conflictResolution": {
          "type": "string",
          "enum": [
            "server",
            "newest",
            "ask"
          ],
          "enumDescriptions": [
            "%config.mirror.conflictResolution.server%",
            "%config.mirror.conflictResolution.newest%",
            "%config.mirror.conflictResolution.ask%"
          ],
          "default": "server",
          "markdownDescription": "%config.mirror.conflictResolution%"
        },
        "remotefs.mirror.autoSyncInterval": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.mirror.autoSyncInterval%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "package": "vsce package",
    "test:integration": "npm run build && node test/integration/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "ftp-srv": "^4.6.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "ssh2": "^1.16.0"
  }
}
