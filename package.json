{
  "name": "remotefs",
  "displayName": "Remote FS 2",
  "description": "Work with files on SFTP/FTP servers as if they were local, with a connection manager UI.",
  "version": "0.1.0",
  "publisher": "michediana",
  "author": "Michele Diana",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Michediana/vscode-remote-fs-2.git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "ftp",
    "ftps",
    "sftp",
    "filesystem",
    "remote"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:sftp",
    "onFileSystem:ftp",
    "onFileSystem:ftps",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Connections defined in workspace settings are ignored in untrusted workspaces.",
      "restrictedConfigurations": [
        "remotefs.remote"
      ]
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remotefs",
          "title": "Remote FS 2",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "remotefs": [
        {
          "id": "remotefs.connections",
          "name": "Connections",
          "icon": "$(server-environment)",
          "contextualTitle": "Remote FS 2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remotefs.connections",
        "contents": "No remote connections configured yet.\n[Add Connection](command:remotefs.addConnection)\n[Import Connections](command:remotefs.importConnections)\nConnections are stored in the `remotefs.remote` setting; passwords are kept in the OS keychain."
      }
    ],
    "commands": [
      {
        "command": "remotefs.addFolderToWorkspace",
        "title": "Add Folder to Workspace",
        "category": "Remote FS 2",
        "icon": "$(add)"
      },
      {
        "command": "remotefs.openMirror",
        "title": "Open Local Mirror (for AI agents)",
        "category": "Remote FS 2",
        "icon": "$(cloud-download)"
      },
      {
        "command": "remotefs.downloadMirrorFolder",
        "title": "Download Folder from Server",
        "category": "Remote FS 2",
        "icon": "$(cloud-download)"
      },
      {
        "command": "remotefs.syncMirror",
        "title": "Sync Local Mirror Now",
        "category": "Remote FS 2",
        "icon": "$(sync)"
      },
      {
        "command": "remotefs.resolveMirrorConflicts",
        "title": "Resolve Local Mirror Conflicts",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.unlinkMirror",
        "title": "Stop Syncing Local Mirror",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.addConnection",
        "title": "Add Connection",
        "category": "Remote FS 2",
        "icon": "$(add)"
      },
      {
        "command": "remotefs.editConnection",
        "title": "Edit Connection",
        "category": "Remote FS 2",
        "icon": "$(edit)"
      },
      {
        "command": "remotefs.duplicateConnection",
        "title": "Duplicate Connection",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.deleteConnection",
        "title": "Delete Connection",
        "category": "Remote FS 2",
        "icon": "$(trash)"
      },
      {
        "command": "remotefs.openInWorkspace",
        "title": "Add to Workspace",
        "category": "Remote FS 2",
        "icon": "$(folder-opened)"
      },
      {
        "command": "remotefs.openInNewWindow",
        "title": "Open in New Window",
        "category": "Remote FS 2",
        "icon": "$(empty-window)"
      },
      {
        "command": "remotefs.openInCurrentWindow",
        "title": "Open in Current Window",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.testConnection",
        "title": "Test Connection",
        "category": "Remote FS 2",
        "icon": "$(debug-alt-small)"
      },
      {
        "command": "remotefs.disconnect",
        "title": "Disconnect",
        "category": "Remote FS 2",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "remotefs.disconnectAll",
        "title": "Disconnect All",
        "category": "Remote FS 2",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "remotefs.forgetPassword",
        "title": "Forget Saved Password",
        "category": "Remote FS 2"
      },
      {
        "command": "remotefs.refresh",
        "title": "Refresh",
        "category": "Remote FS 2",
        "icon": "$(refresh)"
      },
      {
        "command": "remotefs.exportConnections",
        "title": "Export Connections…",
        "category": "Remote FS 2",
        "icon": "$(export)"
      },
      {
        "command": "remotefs.importConnections",
        "title": "Import Connections…",
        "category": "Remote FS 2",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "remotefs.openSettingsJson",
        "title": "Edit Connections in settings.json",
        "category": "Remote FS 2",
        "icon": "$(json)"
      },
      {
        "command": "remotefs.showLog",
        "title": "Show Log",
        "category": "Remote FS 2",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remotefs.addConnection",
          "when": "view == remotefs.connections",
          "group": "navigation@1"
        },
        {
          "command": "remotefs.refresh",
          "when": "view == remotefs.connections",
          "group": "navigation@2"
        },
        {
          "command": "remotefs.disconnectAll",
          "when": "view == remotefs.connections",
          "group": "navigation@3"
        },
        {
          "command": "remotefs.importConnections",
          "when": "view == remotefs.connections",
          "group": "more@1"
        },
        {
          "command": "remotefs.exportConnections",
          "when": "view == remotefs.connections",
          "group": "more@2"
        },
        {
          "command": "remotefs.openSettingsJson",
          "when": "view == remotefs.connections",
          "group": "more@3"
        },
        {
          "command": "remotefs.showLog",
          "when": "view == remotefs.connections",
          "group": "more@4"
        }
      ],
      "view/item/context": [
        {
          "command": "remotefs.openInWorkspace",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "inline@1"
        },
        {
          "command": "remotefs.openMirror",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "inline@2"
        },
        {
          "command": "remotefs.editConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "inline@3"
        },
        {
          "command": "remotefs.disconnect",
          "when": "view == remotefs.connections && viewItem == remotefs.connection.connected",
          "group": "inline@4"
        },
        {
          "command": "remotefs.openInWorkspace",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@1"
        },
        {
          "command": "remotefs.openInNewWindow",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@2"
        },
        {
          "command": "remotefs.openMirror",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@4"
        },
        {
          "command": "remotefs.openInCurrentWindow",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "1_open@3"
        },
        {
          "command": "remotefs.testConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "2_conn@1"
        },
        {
          "command": "remotefs.disconnect",
          "when": "view == remotefs.connections && viewItem == remotefs.connection.connected",
          "group": "2_conn@2"
        },
        {
          "command": "remotefs.forgetPassword",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "2_conn@3"
        },
        {
          "command": "remotefs.editConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@1"
        },
        {
          "command": "remotefs.duplicateConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@2"
        },
        {
          "command": "remotefs.exportConnections",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@3"
        },
        {
          "command": "remotefs.deleteConnection",
          "when": "view == remotefs.connections && viewItem =~ /^remotefs\\.connection/",
          "group": "3_edit@4"
        }
      ],
      "commandPalette": [
        {
          "command": "remotefs.openInWorkspace",
          "when": "false"
        },
        {
          "command": "remotefs.openInCurrentWindow",
          "when": "false"
        },
        {
          "command": "remotefs.duplicateConnection",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "remotefs.openMirror",
          "when": "explorerResourceIsFolder && resourceScheme =~ /^(s?ftp|ftps)$/",
          "group": "remotefs@1"
        },
        {
          "command": "remotefs.downloadMirrorFolder",
          "when": "explorerResourceIsFolder && resourceScheme == file && remotefs.hasMirror",
          "group": "remotefs@2"
        },
        {
          "command": "remotefs.syncMirror",
          "when": "explorerResourceIsRoot && resourceScheme == file && remotefs.hasMirror",
          "group": "remotefs@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Remote FS 2",
      "properties": {
        "remotefs.rootLabel": {
          "type": "string",
          "markdownDescription": "Label of the workspace folder added for a remote. With the default label, ` — <folder>` is appended for a subfolder and ` (remote)` always, to tell it apart from local mirrors (labelled ` (local mirror)`).\n- `${label}`: display label of the connection (falls back to its name).\n- `${name}`: name of the connection.\n- `${folderName}`: last segment of the remote folder.\n- `${path}`: full remote path of the folder.",
          "default": "${label}"
        },
        "remotefs.remote": {
          "type": "object",
          "markdownDescription": "Remote connections (key = connection name, used as `<scheme>://<name>/` URI authority). Prefer the **Remote FS 2** view in the Activity Bar to manage them.",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "required": [
              "scheme",
              "host"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "enum": [
                  "sftp",
                  "ftp",
                  "ftps"
                ],
                "description": "Protocol."
              },
              "label": {
                "type": "string",
                "description": "Optional display label."
              },
              "host": {
                "type": "string",
                "description": "Hostname or IP address of the server."
              },
              "port": {
                "type": "number",
                "description": "Port (default 22 for sftp, 21 for ftp/ftps)."
              },
              "username": {
                "type": "string",
                "description": "Username for authentication."
              },
              "password": {
                "type": "string",
                "description": "Plain-text password (discouraged: use the connection editor to store it in the OS keychain)."
              },
              "rootPath": {
                "type": "string",
                "description": "Absolute path on the remote used as root of the file system.",
                "default": "/"
              },
              "connectTimeout": {
                "type": "number",
                "description": "Connection timeout in milliseconds.",
                "default": 10000
              },
              "privateKeyPath": {
                "type": "string",
                "description": "(sftp) Path to the private key. `~` is expanded."
              },
              "passphrase": {
                "type": [
                  "string",
                  "boolean"
                ],
                "description": "(sftp) Passphrase of the private key, or true to be prompted."
              },
              "agent": {
                "type": "string",
                "description": "(sftp) Path to ssh-agent's socket, or 'pageant' on Windows. Use '$SSH_AUTH_SOCK' to read it from the environment."
              },
              "interactiveAuth": {
                "type": "boolean",
                "description": "(sftp) Enable keyboard-interactive authentication (e.g. 2FA codes).",
                "default": false
              },
              "algorithms": {
                "type": "object",
                "description": "(sftp) Overrides for the transport algorithms, passed to ssh2 as-is."
              },
              "secure": {
                "type": [
                  "boolean",
                  "string"
                ],
                "enum": [
                  true,
                  false,
                  "implicit"
                ],
                "description": "(ftp) true = explicit FTPS (AUTH TLS), 'implicit' = implicit FTPS. Same as using scheme 'ftps'."
              },
              "rejectUnauthorized": {
                "type": "boolean",
                "description": "(ftps) Reject self-signed / invalid TLS certificates.",
                "default": true
              }
            }
          }
        },
        "remotefs.mirror.baseFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder where local mirrors are created by default (`<baseFolder>/<connection>/<remote path>`). Empty = `~/RemoteFS`."
        },
        "remotefs.mirror.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            "node_modules",
            ".DS_Store",
            "Thumbs.db"
          ],
          "markdownDescription": "Paths never synced by local mirrors. A pattern without `/` matches a name at any depth (`*.log`, `cache`); a pattern with `/` is relative to the mirror root (`wp-content/uploads`). `*`, `?` and `**` are supported."
        },
        "remotefs.mirror.maxFileSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "markdownDescription": "Files larger than this are not synced by local mirrors. `0` = no limit."
        },
        "remotefs.mirror.autoSyncInterval": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Seconds between automatic syncs that also download changes made on the server in the folders already opened (minimum 30). `0` = only when the mirror is opened and on **Sync Local Mirror Now**. Local changes are always uploaded immediately."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "package": "vsce package",
    "test:integration": "npm run build && node test/integration/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "ftp-srv": "^4.6.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "ssh2": "^1.16.0"
  }
}
